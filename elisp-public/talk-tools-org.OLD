#+title:      Talk Tools
#+date:       [2026-10-11 Sun 07:09]
#+filetags:   :chat:emacs:howto:writing:
#+identifier: 20261011T070900

These are a set of tools that I developed for giving talks in Emacs.
It provides functions for the following

- Setting a timer at the start of the talk
- Displaying the current time in the modeline
- Displaying keys and functions used
- Giving warnings at various intervals 

* Display keys
#+begin_src elisp :results none
(use-package keycast
  :ensure t
  :bind ("C-c k" . keycast-mode))
#+end_src

* Talk timing functions with warnings

#+begin_src elisp :results none
    (defvar gmj/talk-start-time nil
      "When non-nil, the time the talk started.")

    (defvar gmj/talk-timer nil
      "Timer object for updating the mode line.")

    (defvar gmj/warning-popup-seconds 8
      "How many seconds a warning popup stays visible.")

    (defvar gmj/talk-warning-times
      '((0.25 . "That's enough intro.")
        (0.5 . "Your demo is half done")
        (1. "Wrap up demos")
        (18 . "The end is nigh. Two minute warning")
        (20 . "Done.  Questions?"))
      "Alist of (minutes . message) warnings.
    The list is sorted automatically when a talk starts.")

    (defvar gmj/talk-warnings-remaining nil
      "Internal: warnings not yet displayed.")

    (defun gmj/warning-popup (message &optional seconds)
      "Show MESSAGE in a posframe for SECONDS.
    Default timeout is `gmj/warning-popup-seconds'."
      (interactive "sWarning message: \nnDisplay for seconds: ")
      (posframe-show "*warning-popup*"
                     :string message
                     :position (point)
                     :poshandler #'posframe-poshandler-frame-bottom-right-corner
                     :font "DejaVu Sans Mono-32"
                     :background-color "grey"
                     :foreground-color "black"
                     :timeout (or seconds gmj/warning-popup-seconds)))

    (defun gmj/install-mode-line-timer ()
    (interactive)
    ;; If the current buffer has a local mode-line-format, ignore it.
    (kill-local-variable 'mode-line-format)
    (let ((cell '(:eval (gmj/talk-elapsed))))
      (setq-default mode-line-format
                    (cons cell (remove cell (default-value 'mode-line-format))))))


    (defun gmj/talk-elapsed ()
      "Return elapsed talk time as [M:SS], or nil if no talk is active."
      (when gmj/talk-start-time
        (let* ((elapsed (float-time (time-subtract (current-time)
                                                   gmj/talk-start-time)))
               (minutes (floor elapsed 60))
               (seconds (floor (- elapsed (* minutes 60)))))
          (format " [%d:%02d]" minutes seconds))))

    (defun gmj/talk-tick ()
      "Check for due warnings and redraw the mode line."
      (when gmj/talk-start-time
        (let ((elapsed-mins (/ (float-time (time-subtract (current-time)
                                                          gmj/talk-start-time))
                               60.0)))
          (while (and gmj/talk-warnings-remaining
                      (>= elapsed-mins (caar gmj/talk-warnings-remaining)))
            (let ((warning (pop gmj/talk-warnings-remaining)))
              (gmj/warning-popup (cdr warning)))))
        (force-mode-line-update)))

    (defun gmj/talk-start ()
      "Start the talk timer, initialize warnings, enable mode-line display."
      (interactive)
      (gmj/install-mode-line-timer)
      (setq gmj/talk-start-time (current-time))
      (setq gmj/talk-warnings-remaining
            (sort (copy-tree gmj/talk-warning-times)
                  (lambda (a b) (< (car a) (car b)))))
      (unless gmj/talk-timer
        (setq gmj/talk-timer
              (run-with-timer 0 1 #'gmj/talk-tick)))
      (message "Talk timer started."))

    (defun gmj/talk-stop ()
      "Stop the talk timer, clear warnings, and hide any popup."
      (interactive)
      (setq gmj/talk-start-time nil
            gmj/talk-warnings-remaining nil)
      (when gmj/talk-timer
        (cancel-timer gmj/talk-timer)
        (setq gmj/talk-timer nil))
      (when (fboundp 'posframe-hide)
        (ignore-errors (posframe-hide "*warning-popup*")))
      (force-mode-line-update)
      (message "Talk timer stopped."))

  (global-set-key (kbd "C-c t") #'gmj/talk-start)
  (global-set-key (kbd "C-c T") #'gmj/talk-stop)
#+end_src

